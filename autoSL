   Lbl("d_ft_srv",  px+PW_-sz(192),ffY+sz(4),"copyright by TVH-SMILE",C_MUTED, F_BODY);

   ChartRedraw(0);
}

//======================================================================
//  PANEL TOGGLE
//======================================================================
void PanelToggle()
{
   for(int i=0;i<ArraySize(gObjs);i++){
      string n=gObjs[i];
      bool keepVisible=(n=="d_btn_hide"||n=="d_btn_hide_bg");
      ObjVis(n, keepVisible ? true : !gHidden);
   }
   if(gCanvasReady)
      ObjectSetInteger(0,CANVAS_NAME,OBJPROP_TIMEFRAMES,gHidden?OBJ_NO_PERIODS:OBJ_ALL_PERIODS);
}

//======================================================================
//  PANEL UPDATE
//======================================================================
void PanelUpdate()
{
   MqlDateTime dt; TimeToStruct(TimeCurrent(),dt);
   ObjTxt("d_hdr_clock",TimeToString(TimeCurrent(),TIME_SECONDS));
   if(gHidden){ ChartRedraw(0); return; }

   int PW_=sz(PW_BASE), MH=sz(MARGIN_H);
   double m5hCur=M5High(),m5lCur=M5Low();
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   double slS=NormalizeDouble(m5hCur,dg);
   double slB=NormalizeDouble(m5lCur,dg);
   int pc=CntPos();
   double pnl=TotPnL();
   double m5h=m5hCur,m5l=m5lCur;
   bool hasCloseSignal=(InpAutoClose&&dt.min==InpCloseMinute);

   if(gBatchRunning)   { ObjTxt("d_hdr_status","[BUSY]");    ObjClr("d_hdr_status",C_ORANGE); }
   else if(hasCloseSignal){ ObjTxt("d_hdr_status","[CLOSING]"); ObjClr("d_hdr_status",C_RED); }
   else                { ObjTxt("d_hdr_status","[RUNNING]"); ObjClr("d_hdr_status",C_GREEN);  }

   string scIds2[4]={"d_btn_sc_s","d_btn_sc_m","d_btn_sc_l","d_btn_sc_xl"};
   int    scVals2[4]={80,100,120,150};
   for(int i=0;i<4;i++){
      bool active=(scVals2[i]==gDashScale);
      ObjClr(scIds2[i],active?C_GOLD:C_MUTED);
      ObjectSetInteger(0,scIds2[i]+"_bg",OBJPROP_BGCOLOR,active?C'30,38,56':C_CARD);
   }

   if(gLastCrossType!="")
   {
      color ltClr = (gLastCrossType=="GOLDEN") ? C_GREEN : C_RED;
      string ltTxt = "Last: "+gLastCrossType+" "+TimeToString(iTime(gSym,PERIOD_M5,1),TIME_MINUTES);
      ObjTxt("d_ae_last",ltTxt);
      ObjClr("d_ae_last",ltClr);
   }
   else
   {
      ObjTxt("d_ae_last","Last: ---");
      ObjClr("d_ae_last",C_MUTED2);
   }

   ObjTxt("d_btn_ae", gAutoEntry ? "AUTO ENTRY: ON" : "AUTO ENTRY: OFF");
   ObjTxt("d_ema_fval",(string)gEmaFast);
   ObjTxt("d_ema_mval",(string)gEmaMid);
   ObjTxt("d_ema_sval",(string)gEmaSlow);
   ObjTxt("d_days_val",(string)gAnalysisDays+"D");
   if(gManualPlanTime<=0)
   {
      ObjTxt("d_btn_candle","ANALYZE "+(string)gAnalysisDays+"D");
      ObjClr("d_btn_candle",C_CYAN);
      ObjectSetInteger(0,"d_btn_candle_bg",OBJPROP_BGCOLOR,C'14,22,34');
      ObjectSetInteger(0,"d_btn_candle_bg",OBJPROP_COLOR,C_CYAN);
      ObjTxt("d_btn_limit","LIMIT");
      ObjClr("d_btn_limit",C_GREEN);
      ObjectSetInteger(0,"d_btn_limit_bg",OBJPROP_BGCOLOR,C'16,28,20');
      ObjectSetInteger(0,"d_btn_limit_bg",OBJPROP_COLOR,C_GREEN);
   }

   EmaSnap ema; Signal sig;
   if(GetEMA(ema)){
      sig=Analyze(ema);
      ObjTxt("d_ema_shbdg",sig.trend); ObjClr("d_ema_shbdg",sig.tc);
      ObjTxt("d_ema_trv",sig.trend);   ObjClr("d_ema_trv",sig.tc);
      ObjTxt("d_ema_sgv",sig.sig);     ObjClr("d_ema_sgv",sig.sc);
      ObjTxt("d_ema_stv",sig.str);
      ObjClr("d_ema_stv",sig.str=="MANH"?C_GREEN:sig.str=="TRUNG BINH"?C_YELLOW:C_ORANGE);
      ObjTxt("d_ema_rsn",sig.reason);
      ObjTxt("d_ema_score_v",(string)sig.score); ObjClr("d_ema_score_v",sig.tc);
      ObjTxt("d_mid_signal",sig.sig); ObjClr("d_mid_signal",sig.sc);
      ObjTxt("d_mid_trend",sig.trend); ObjClr("d_mid_trend",sig.tc);
      ObjTxt("d_mid_meta",StringFormat("Score %d | %s",sig.score,sig.str));
      ObjClr("d_mid_meta",sig.str=="MANH"?C_GREEN:sig.str=="TRUNG BINH"?C_YELLOW:C_MUTED);
      int ema_inner_w=PW_-MH;
      ObjW("d_sbar_fill",(int)(ema_inner_w*sig.score/100.0));
      ObjBg("d_sbar_fill",sig.tc);

      if(gManualPlanActive && gManualPlan.ready)
      {
         ObjTxt("d_plan_txt",StringFormat("Entry %s: %.2f",gManualPlan.dir,gManualPlan.entry));
         ObjClr("d_plan_txt",gManualPlan.clr);
         ObjTxt("d_risk_txt",StringFormat("SL %.2f | TP %.2f",gManualPlan.sl,gManualPlan.tp));
         ObjClr("d_risk_txt",C_MUTED);
      }
      else
      {
         ObjTxt("d_plan_txt","Entry: ---");
         ObjClr("d_plan_txt",C_MUTED);
         ObjTxt("d_risk_txt","SL/TP: ---");
         ObjClr("d_risk_txt",C_MUTED);
      }
   }

   string ps=(pnl>=0?"+":"")+DoubleToString(pnl,2);
   ObjTxt("d_stat_pos",StringFormat("Pos: %d",pc));
   ObjTxt("d_stat_pnl",StringFormat("PnL: %s",ps));
   ObjClr("d_stat_pnl",pnl>0?C_GREEN:pnl<0?C_RED:C_MUTED);
   ObjTxt("d_stat_sl",StringFormat("SL B:%.2f | S:%.2f",slB,slS));
   ObjTxt("d_stat_lv",StringFormat("M5: %.2f / %.2f",m5h,m5l));

   string lineTxt;
   color lineClr=C_MUTED;
   if(gBatchRunning) { lineTxt="Processing orders..."; lineClr=C_ORANGE; }
   else if(hasCloseSignal&&pc>0) { lineTxt=StringFormat("AutoClose time active at minute %02d",InpCloseMinute); lineClr=C_RED; }
   else if(gManualPlanText!="") { lineTxt=gManualPlanText; lineClr=gManualPlanActive?gManualPlan.clr:C_ORANGE; }
   else if(gLastCrossType!="") { lineTxt="Last cross: "+gLastCrossType; lineClr=(gLastCrossType=="GOLDEN")?C_GREEN:C_RED; }
   else lineTxt="Waiting for confirmed M5 signal";
   ObjTxt("d_line_txt",lineTxt);
   ObjClr("d_line_txt",lineClr);

   ObjTxt("d_ft_time",TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS));
   ChartRedraw(0);
}
