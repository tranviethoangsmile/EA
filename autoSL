//======================================================================
//  FIX: EnforceStopDistance — fallback minDist thực tế hơn khi STOPS_LEVEL=0
//======================================================================
void EnforceStopDistance(const int dir,const double entry,double& sl,double& tp)
{
   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   double minDist=(double)SymbolInfoInteger(gSym,SYMBOL_TRADE_STOPS_LEVEL)*pt;
   // FIX: khi broker trả về STOPS_LEVEL=0, dùng 10% InpMinSL_Points làm fallback
   // thay vì 1 point — tránh SL quá gần entry bị reject
   if(minDist<=0) minDist=InpMinSL_Points*pt*0.10;
   if(minDist<=0) minDist=pt; // absolute last resort

   if(dir==POSITION_TYPE_BUY)
   {
      if(entry-sl<minDist) sl=entry-minDist;
      if(tp>0 && tp-entry<minDist) tp=entry+minDist;
   }
   else
   {
      if(sl-entry<minDist) sl=entry+minDist;
      if(tp>0 && entry-tp<minDist) tp=entry-minDist;
   }
   sl=NormalizeDouble(sl,dg);
   if(tp>0) tp=NormalizeDouble(tp,dg);
}

bool BuildAutoEntryStops(const int dir,const double entry,double& sl,double& tp)
{
   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   if(pt<=0) return false;

   if(!InpSmartSLTP)
   {
      if(dir==POSITION_TYPE_BUY)
      {
         if(InpTP_Points>0) tp=NormalizeDouble(entry+InpTP_Points*pt,dg);
         if(InpSL_Cross_Points>0) sl=NormalizeDouble(entry-InpSL_Cross_Points*pt,dg);
         else { double h1l=H1Low(); if(h1l>0) sl=NormalizeDouble(h1l-InpExtraPoints*pt,dg); }
      }
      else
      {
         if(InpTP_Points>0) tp=NormalizeDouble(entry-InpTP_Points*pt,dg);
         if(InpSL_Cross_Points>0) sl=NormalizeDouble(entry+InpSL_Cross_Points*pt,dg);
         else { double h1h=H1High(); if(h1h>0) sl=NormalizeDouble(h1h+InpExtraPoints*pt,dg); }
      }
      if(sl<=0) return false;
      EnforceStopDistance(dir,entry,sl,tp);
      return true;
   }

   double atr=ATR_M5();
   double minRisk=MathMax(InpMinSL_Points*pt,(double)SymbolInfoInteger(gSym,SYMBOL_TRADE_STOPS_LEVEL)*pt);
   double maxRisk=InpMaxSL_Points>0?InpMaxSL_Points*pt:0;
   double rr=MathMax(0.1,InpTP_RR);
   double structBuffer=MathMax(0,InpStructureBuffer)*pt;
   double risk=0;

   if(dir==POSITION_TYPE_BUY)
   {
      double structLow=M5StructLow(InpStructureBars);
      double atrSL=atr>0?entry-atr*InpSL_ATR_Mult:0;
      double structSL=structLow>0?structLow-structBuffer:0;
      sl=(structSL>0&&atrSL>0)?MathMin(structSL,atrSL):(structSL>0?structSL:atrSL);
      if(sl<=0) sl=entry-minRisk;
      risk=entry-sl;
      if(risk<minRisk) risk=minRisk;
      if(maxRisk>0&&risk>maxRisk) risk=maxRisk;
      sl=NormalizeDouble(entry-risk,dg);
      tp=NormalizeDouble(entry+risk*rr,dg);
   }
   else
   {
      double structHigh=M5StructHigh(InpStructureBars);
      double atrSL=atr>0?entry+atr*InpSL_ATR_Mult:0;
      double structSL=structHigh>0?structHigh+structBuffer:0;
      sl=(structSL>0&&atrSL>0)?MathMax(structSL,atrSL):(structSL>0?structSL:atrSL);
      if(sl<=0) sl=entry+minRisk;
      risk=sl-entry;
      if(risk<minRisk) risk=minRisk;
      if(maxRisk>0&&risk>maxRisk) risk=maxRisk;
      sl=NormalizeDouble(entry+risk,dg);
      tp=NormalizeDouble(entry-risk*rr,dg);
   }

   EnforceStopDistance(dir,entry,sl,tp);
   return (sl>0 && tp>0);
}

//======================================================================
//  FIX: TG_Send — encode đầy đủ hơn cho giá số thực (dấu . , %)
//======================================================================
bool TG_Send(string message)
{
   if(!TG_Enable) return true;
   if(TG_BotToken=="YOUR_BOT_TOKEN" || TG_ChatID=="YOUR_CHAT_ID")
   {
      Print("TG: Token/ChatID not configured");
      return false;
   }

   string encoded=message;
   // Encode theo thứ tự: & và = trước, sau đó các ký tự còn lại
   StringReplace(encoded,"&", "%26");
   StringReplace(encoded,"=", "%3D");
   StringReplace(encoded,"+", "%2B");
   StringReplace(encoded,"#", "%23");
   StringReplace(encoded,"<", "%3C");
   StringReplace(encoded,">", "%3E");
   StringReplace(encoded,":", "%3A");
   StringReplace(encoded,"/", "%2F");
   // FIX: thêm encode cho dấu chấm và phẩy — quan trọng với giá số thực XAUUSD
   StringReplace(encoded,".", "%2E");
   StringReplace(encoded,",", "%2C");
   // Encode space và newline cuối cùng
   StringReplace(encoded,"\n","%0A");
   StringReplace(encoded," ", "%20");

   string url="https://api.telegram.org/bot"+TG_BotToken+"/sendMessage";
   string body="chat_id="+TG_ChatID+"&text="+encoded+"&parse_mode=HTML";
   char post[],result[];
   string headers="Content-Type: application/x-www-form-urlencoded\r\n";
   string resultHeaders;
   StringToCharArray(body,post,0,WHOLE_ARRAY,CP_UTF8);
   if(ArraySize(post)>0) ArrayResize(post,ArraySize(post)-1);
   int res=WebRequest("POST",url,headers,7000,post,result,resultHeaders);
   if(res==-1)
   {
      int err=GetLastError();
      Print("TG WebRequest error: ",err," | Add https://api.telegram.org to WebRequest allowed URLs");
      Alert("Telegram WebRequest error ",err,". Allow https://api.telegram.org in MT5 Options.");
      return false;
   }
   string response=CharArrayToString(result,0,-1,CP_UTF8);
   if(res!=200)
   {
      Print("TG HTTP error: ",res," | ",response);
      Alert("Telegram HTTP error ",res,". Check Bot Token / Chat ID / bot started.");
      return false;
   }
   Print("TG sent OK: ",response);
   return true;
}

