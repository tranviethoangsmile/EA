int OnInit()
{
   gSym = (InpSymbol == "") ? Symbol() : InpSymbol;
   if(!SymbolSelect(gSym, true)){ Alert("Symbol not found: " + gSym); return INIT_FAILED; }

   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(20);
   trade.SetAsyncMode(false);

   gEmaFast = InpEMA_Fast;
   gEmaMid  = InpEMA_Mid;
   gEmaSlow = InpEMA_Slow;
   gAnalysisDays = MathMax(1,InpCandleAnalysisDays);

   gAutoEntry = InpAutoEntryDefault;

   if(!ReinitEmaHandles()) return INIT_FAILED;

   Log("EA v11.01 | " + gSym + " | Scale=" + (string)gDashScale + "% | EMA "
       + (string)gEmaFast + "/" + (string)gEmaMid + "/" + (string)gEmaSlow, "info");
   Log(StringFormat("SL buffer=%.0fpt | BE $%.0f>>+$%.0f | AutoClose theo phut %02d",
       InpExtraPoints, InpBETrigger, InpBELock, InpCloseMinute), "info");
   Log(StringFormat("AutoEntry=%s | Lot=%.2f | TP=%.0fpt | Cooldown=%d bars",
       gAutoEntry?"ON":"OFF", InpLotSize, InpTP_Points, InpCrossCooldownBars), "info");
   Log(StringFormat("SmartSLTP=%s | ATRx%.1f | RR=%.1f | SL %.0f..%.0f pt",
       InpSmartSLTP?"ON":"OFF", InpSL_ATR_Mult, InpTP_RR, InpMinSL_Points, InpMaxSL_Points), "info");

   BuildPanel();
   if(!InitCanvas()) Log("Canvas init failed","err");
   DrawChartOverlay();

   InitCrossState();

   EventSetTimer(InpCheckInterval);
   TG_OnStart();
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   IndicatorRelease(hFast);
   IndicatorRelease(hMid);
   IndicatorRelease(hSlow);
   IndicatorRelease(hATR);
   if(gCanvasReady){ gEmaCanvas.Destroy(); gCanvasReady = false; }
   ObjectDelete(0,CANVAS_NAME);
   DeleteObjectsByPrefix(OVERLAY_PREFIX);
   ObjDeleteAll();
}

