void DoSetSL()
{
   double m5h=M5High(); if(m5h<=0) return;
   double m5l=M5Low();  if(m5l<=0) return;
   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   int    dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   double slS=NormalizeDouble(m5h,dg);
   double slB=NormalizeDouble(m5l,dg);
   ulong need[]; int nc=0;
   for(int i=PositionsTotal()-1;i>=0;i--){
      if(!posInfo.SelectByIndex(i)||posInfo.Symbol()!=gSym) continue;
      if(InpProtectAESL&&IsAEPosition()) continue;
      int tp=(int)posInfo.PositionType(); ulong tk=posInfo.Ticket(); double cs=posInfo.StopLoss();
      if(InpOnlyBuy&&tp!=POSITION_TYPE_BUY) continue;
      if(InpOnlySell&&tp!=POSITION_TYPE_SELL) continue;
      double tSL=(tp==POSITION_TYPE_BUY)?slB:slS;
      bool done=InSL(tk);
      if(cs!=0&&!InpOverwriteSL&&done) continue;
      if(MathAbs(cs-tSL)<pt*0.5&&done) continue;
      if(InBE(tk)){ if(tp==POSITION_TYPE_BUY&&cs>=tSL) continue; if(tp==POSITION_TYPE_SELL&&cs<=tSL) continue; }
      ArrayResize(need,nc+1); need[nc++]=tk;
   }
   if(nc==0){ CleanTicks(); return; }
   gBatchRunning=true;
   int ok=0,fail=0;
   for(int i=0;i<nc;i++){
      if(!PositionSelectByTicket(need[i])) continue;
      int tp=(int)PositionGetInteger(POSITION_TYPE);
      double tSL=(tp==POSITION_TYPE_BUY)?slB:slS;
      double tp2=PositionGetDouble(POSITION_TP);
      if(ModRetry(need[i],tSL,tp2)){ ok++; statSLOk++; AddSL(need[i]); }
      else{ fail++; statSLFail++; Log(StringFormat("FAIL SL #%I64u",need[i]),"err"); }
      if(i<nc-1&&InpBatchDelay>0) Sleep(InpBatchDelay);
   }
   gBatchRunning=false;
   Log(StringFormat("SL M5: %d OK / %d FAIL | BUY=%.2f SELL=%.2f",ok,fail,slB,slS),ok>0?"ok":"err");
   if(InpAlertOnSet&&ok>0) Alert(StringFormat("[AutoSL M5] %d lenh | BUY SL=%.2f | SELL SL=%.2f",ok,slB,slS));
   CleanTicks();
}

void DoBreakeven()
{
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   for(int i=PositionsTotal()-1;i>=0;i--){
      if(!posInfo.SelectByIndex(i)||posInfo.Symbol()!=gSym) continue;
      int tp=(int)posInfo.PositionType(); ulong tk=posInfo.Ticket();
      double lot=posInfo.Volume(),entry=posInfo.PriceOpen(),cSL=posInfo.StopLoss(),cTP=posInfo.TakeProfit();
      double pnl=posInfo.Profit()+posInfo.Swap()+posInfo.Commission();
      if((InpOnlyBuy&&tp!=POSITION_TYPE_BUY)||(InpOnlySell&&tp!=POSITION_TYPE_SELL)) continue;
      if(InBE(tk)||pnl<InpBETrigger) continue;
      double off=USD2Pt(InpBELock,lot); if(off<=0) continue;
      double newSL=0;
      if(tp==POSITION_TYPE_BUY){ newSL=NormalizeDouble(entry+off,dg); if(cSL>=newSL) continue; }
      else                     { newSL=NormalizeDouble(entry-off,dg); if(cSL>0&&cSL<=newSL) continue; }
      if(ModRetry(tk,newSL,cTP)){
         statBEOk++; AddBE(tk);
         string dir=(tp==POSITION_TYPE_BUY)?"BUY":"SELL";
         Log(StringFormat("BE+ #%I64u %s $%.2f >> SL=%.2f (+$%.2f)",tk,dir,pnl,newSL,InpBELock),"ok");
         Alert(StringFormat("[BE+] #%I64u %s | Lai=$%.2f | SL=%.2f | Lock +$%.2f",tk,dir,pnl,newSL,InpBELock));
         TG_Send(StringFormat("BREAKEVEN %s\nTicket: #%I64u\nPnL: %.2f\nNew SL: %s",
                 dir,tk,pnl,TG_Price(newSL)));
      }
   }
}

void DoAutoClose()
{
   static bool invalidMinuteWarned = false;
   if(InpCloseMinute < 0 || InpCloseMinute > 59)
   {
      if(!invalidMinuteWarned)
      {
         Log("AutoClose disabled: InpCloseMinute must be 0..59","err");
         invalidMinuteWarned = true;
      }
      return;
   }

   MqlDateTime d;
   TimeToStruct(TimeCurrent(), d);

   int mnLeft = InpCloseMinute - d.min;
   if(mnLeft < 0) mnLeft += 60;

   if(mnLeft > 0)
   {
      gLastCloseMn = -1;
      if(InpCloseWarning > 0 && mnLeft <= InpCloseWarning && gLastWarnMn != d.min)
      {
         gLastWarnMn = d.min;
         Log(StringFormat("AutoClose warning: %d minute(s) left before minute %02d",mnLeft,InpCloseMinute),"warn");
      }
      return;
   }

   if(gLastCloseMn == d.min) return;

   ulong tc[]; int tcc=0;
   for(int i=PositionsTotal()-1;i>=0;i--){
      if(!posInfo.SelectByIndex(i)||posInfo.Symbol()!=gSym) continue;
      int tp=(int)posInfo.PositionType();
      if((InpOnlyBuy&&tp!=POSITION_TYPE_BUY)||(InpOnlySell&&tp!=POSITION_TYPE_SELL)) continue;
      ArrayResize(tc,tcc+1); tc[tcc++]=posInfo.Ticket();
   }
   gLastCloseMn = d.min;
   if(tcc==0) return;
   gBatchRunning=true;
   Log(StringFormat("AUTO CLOSE TIME: dong %d lenh tai phut %02d",tcc,InpCloseMinute),"warn");
   int ok=0,fail=0;
   for(int i=0;i<tcc;i++){
      if(ClsRetry(tc[i])){ ok++; statClOk++; AddCL(tc[i]); }
      else{ fail++; statClFail++; }
      if(i<tcc-1&&InpBatchDelay>0) Sleep(InpBatchDelay);
   }
   gBatchRunning=false;
   Log(StringFormat("Close: %d OK / %d FAIL",ok,fail),ok>0?"ok":"err");
   if(InpAlertOnClose) Alert(StringFormat("[AutoClose Time] %d/%d lenh | Minute=%02d",ok,tcc,InpCloseMinute));
   TG_Send(StringFormat("AUTO CLOSE TIME\nSymbol: %s\nClosed: %d/%d\nMinute: %02d",gSym,ok,tcc,InpCloseMinute));
}

//======================================================================
//  v11: AUTO ENTRY ON EMA CROSS
//
//  FIX 1: iBarShift dùng exact=true thay vì false
//  FIX 2: gLastCrossBar set TRƯỚC khi mở lệnh (không phụ thuộc kết quả)
//  FIX 3: off-by-one — cooldown tính từ bar[1] về bar[0] = 1 tick,
//         nên prevIdx từ iBarShift đã đo đúng; chỉ cần đảm bảo exact=true
//======================================================================
void CheckEMACross()
{
   if(!gAutoEntry) return;
   if(gBatchRunning) return;

   double f[], m[];
   ArraySetAsSeries(f,true); ArraySetAsSeries(m,true);
   if(CopyBuffer(hFast,0,0,3,f)<3 || CopyBuffer(hMid,0,0,3,m)<3) return;

   bool curAbove = (f[1] > m[1]);
   bool curBelow = (f[1] < m[1]);
   bool prvAbove = gPrevGolden;
   bool prvBelow = gPrevDeath;

   bool isGolden = (!prvAbove && curAbove);
   bool isDeath  = (!prvBelow && curBelow);

   // Cập nhật trạng thái cho lần check tiếp theo
   gPrevGolden = curAbove;
   gPrevDeath  = curBelow;

   if(!isGolden && !isDeath) return;

   datetime barTime = iTime(gSym, PERIOD_M5, 1);

   // Cooldown check: barTime == gLastCrossBar nghĩa là cùng bar đã xử lý
   if(barTime == gLastCrossBar) return;

   // FIX 1: dùng exact=true để iBarShift trả về -1 khi không tìm thấy
   //        thay vì tìm bar gần nhất (có thể gây false cooldown)
   if(InpCrossCooldownBars > 0 && gLastCrossBar > 0)
   {
      int prevIdx = iBarShift(gSym, PERIOD_M5, gLastCrossBar, true);
      // Nếu bar không còn trong history (prevIdx==-1), bỏ qua cooldown
      if(prevIdx >= 0 && prevIdx < InpCrossCooldownBars + 1) return;
   }

   if(isGolden && InpOnlySell) return;
   if(isDeath  && InpOnlyBuy)  return;

   if(InpBlockOppSignal)
   {
      EmaSnap snap;
      if(GetEMA(snap))
      {
         Signal curSig=Analyze(snap);
         if(isGolden && curSig.sig=="SELL")
         {
            Log("AE BUY blocked: current EMA signal is SELL","warn");
            TG_OnFail("AE BUY","Blocked because current EMA signal is SELL");
            return;
         }
         if(isDeath && curSig.sig=="BUY")
         {
            Log("AE SELL blocked: current EMA signal is BUY","warn");
            TG_OnFail("AE SELL","Blocked because current EMA signal is BUY");
            return;
         }
      }
   }

   double ask = SymbolInfoDouble(gSym, SYMBOL_ASK);
   double bid = SymbolInfoDouble(gSym, SYMBOL_BID);
   double tpPrice = 0.0;
   double slPrice = 0.0;
   string analysisDetail = "";

   if(isGolden)
   {
      if(!BuildAutoEntryStopsFromAnalysis(POSITION_TYPE_BUY,ask,slPrice,tpPrice,analysisDetail))
      {
         statAEFail++;
         // FIX 2: set gLastCrossBar ngay cả khi fail tính SL/TP
         // để tránh retry liên tục trên cùng 1 cross signal
         gLastCrossBar  = barTime;
         gLastCrossType = "GOLDEN";
         Log("AE BUY FAIL: "+analysisDetail,"err");
         TG_OnFail("AE BUY",analysisDetail);
         return;
      }

      Log(StringFormat("GOLDEN CROSS -> BUY | Lot=%.2f | Ask=%.2f | TP=%.2f | SL=%.2f | %s",
          InpLotSize, ask, tpPrice, slPrice, analysisDetail), "info");
      TG_OnSignal(POSITION_TYPE_BUY,ask,slPrice,tpPrice);

      // FIX 2: set gLastCrossBar TRƯỚC khi gọi trade.Buy
      // để mọi tình huống (ok/fail/exception) đều không re-enter trên bar này
      gLastCrossBar  = barTime;
      gLastCrossType = "GOLDEN";

      bool ok = trade.Buy(InpLotSize, gSym, ask, slPrice, tpPrice,
                          StringFormat("AE Golden %d/%d",gEmaFast,gEmaMid));
      if(ok)
      {
         statAEOk++;
         Log(StringFormat("AE BUY OK #%I64u | %.2f lots @ %.2f",
             trade.ResultOrder(), InpLotSize, ask), "ok");
         TG_OnOpen(POSITION_TYPE_BUY,ask,slPrice,tpPrice,trade.ResultOrder());
         if(InpEntryAlertCross)
            Alert(StringFormat("[AutoEntry] BUY | Golden Cross EMA%d/%d | Lot=%.2f | @ %.2f",
                  gEmaFast, gEmaMid, InpLotSize, ask));
      }
      else
      {
         statAEFail++;
         Log(StringFormat("AE BUY FAIL: %s (%d)",trade.ResultComment(),trade.ResultRetcode()),"err");
         TG_OnFail("AE BUY",trade.ResultComment());
         // gLastCrossBar đã set, cooldown vẫn hoạt động đúng
      }
   }
   else if(isDeath)
   {
      if(!BuildAutoEntryStopsFromAnalysis(POSITION_TYPE_SELL,bid,slPrice,tpPrice,analysisDetail))
      {
         statAEFail++;
         // FIX 2: set ngay cả khi fail tính SL/TP
         gLastCrossBar  = barTime;
         gLastCrossType = "DEATH";
         Log("AE SELL FAIL: "+analysisDetail,"err");
         TG_OnFail("AE SELL",analysisDetail);
         return;
      }

      Log(StringFormat("DEATH CROSS -> SELL | Lot=%.2f | Bid=%.2f | TP=%.2f | SL=%.2f | %s",
          InpLotSize, bid, tpPrice, slPrice, analysisDetail), "info");
      TG_OnSignal(POSITION_TYPE_SELL,bid,slPrice,tpPrice);

      // FIX 2: set TRƯỚC khi trade.Sell
      gLastCrossBar  = barTime;
      gLastCrossType = "DEATH";

      bool ok = trade.Sell(InpLotSize, gSym, bid, slPrice, tpPrice,
                           StringFormat("AE Death %d/%d",gEmaFast,gEmaMid));
      if(ok)
      {
         statAEOk++;
         Log(StringFormat("AE SELL OK #%I64u | %.2f lots @ %.2f",
             trade.ResultOrder(), InpLotSize, bid), "ok");
         TG_OnOpen(POSITION_TYPE_SELL,bid,slPrice,tpPrice,trade.ResultOrder());
         if(InpEntryAlertCross)
            Alert(StringFormat("[AutoEntry] SELL | Death Cross EMA%d/%d | Lot=%.2f | @ %.2f",
                  gEmaFast, gEmaMid, InpLotSize, bid));
      }
      else
      {
         statAEFail++;
         Log(StringFormat("AE SELL FAIL: %s (%d)",trade.ResultComment(),trade.ResultRetcode()),"err");
         TG_OnFail("AE SELL",trade.ResultComment());
      }
   }
}

//======================================================================
//  EMA ANALYSIS
//======================================================================
bool GetEMA(EmaSnap& e)
{
   double f[],m[],s[];
   ArraySetAsSeries(f,true); ArraySetAsSeries(m,true); ArraySetAsSeries(s,true);
   if(CopyBuffer(hFast,0,0,3,f)<3||CopyBuffer(hMid,0,0,3,m)<3||CopyBuffer(hSlow,0,0,3,s)<3) return false;
   e.f=f[0];e.fp=f[1]; e.m=m[0];e.mp=m[1]; e.s=s[0];e.sp=s[1];
   e.price=SymbolInfoDouble(gSym,SYMBOL_BID);
   return true;
}

Signal Analyze(EmaSnap& e)
{
   Signal r; r.score=50;
   bool fAboveM=e.f>e.m,fAboveS=e.f>e.s,mAboveS=e.m>e.s;
   bool pAboveF=e.price>e.f,pAboveM=e.price>e.m,pAboveS=e.price>e.s;
   bool fRising=e.f>e.fp,mRising=e.m>e.mp;
   bool golden=(e.f>e.m)&&(e.fp<=e.mp), death=(e.f<e.m)&&(e.fp>=e.mp);
   if(fAboveM)r.score+=10;else r.score-=10; if(fAboveS)r.score+=12;else r.score-=12;
   if(mAboveS)r.score+=10;else r.score-=10; if(pAboveF)r.score+=6; else r.score-=6;
   if(pAboveM)r.score+=6; else r.score-=6;  if(pAboveS)r.score+=6; else r.score-=6;
   if(fRising)r.score+=5; else r.score-=5;  if(mRising)r.score+=5; else r.score-=5;
   r.score=MathMax(0,MathMin(100,r.score));
   if(r.score>=65)      {r.trend="BULLISH";r.tc=C_GREEN;}
   else if(r.score<=35) {r.trend="BEARISH";r.tc=C_RED;}
   else                 {r.trend="SIDEWAY";r.tc=C_ORANGE;}
   if(golden&&mAboveS)             {r.sig="BUY"; r.sc=C_GREEN; r.str="MANH";       r.reason=StringFormat("Golden Cross EMA%d/%d | Stack bullish M5",gEmaFast,gEmaMid);}
   else if(death&&!mAboveS)        {r.sig="SELL";r.sc=C_RED;   r.str="MANH";       r.reason=StringFormat("Death Cross EMA%d/%d | Stack bearish M5",gEmaFast,gEmaMid);}
   else if(r.trend=="BULLISH"&&pAboveF&&pAboveM&&fAboveS){r.sig="BUY"; r.sc=C_GREEN;  r.str="TRUNG BINH";r.reason=StringFormat("Gia > EMA%d & EMA%d | Xu huong tang M5",gEmaFast,gEmaMid);}
   else if(r.trend=="BEARISH"&&!pAboveF&&!pAboveM&&!fAboveS){r.sig="SELL";r.sc=C_RED; r.str="TRUNG BINH";r.reason=StringFormat("Gia < EMA%d & EMA%d | Xu huong giam M5",gEmaFast,gEmaMid);}
   else if(r.trend=="BULLISH"&&!pAboveF&&pAboveM){r.sig="BUY"; r.sc=C_YELLOW;r.str="YEU";r.reason=StringFormat("Pullback EMA%d | Cho nen xac nhan M5",gEmaFast);}
   else if(r.trend=="BEARISH"&&pAboveF&&!pAboveM){r.sig="SELL";r.sc=C_YELLOW;r.str="YEU";r.reason=StringFormat("Pullback EMA%d | Cho nen xac nhan M5",gEmaFast);}
   else {r.sig="WAIT";r.sc=C_ORANGE;r.str="---";r.reason="EMA M5 chua xac dinh xu huong ro rang";}
   return r;
}

EntryPlan BuildEntryPlan(EmaSnap& e,Signal& sig)
{
   EntryPlan p;
   p.ready=false; p.dir="WAIT"; p.note="Cho tin hieu ro"; p.entry=0; p.sl=0; p.tp=0; p.clr=C_ORANGE;
   if(sig.sig=="WAIT") return p;

   double ask=SymbolInfoDouble(gSym,SYMBOL_ASK);
   double bid=SymbolInfoDouble(gSym,SYMBOL_BID);
   double atr=ATR_M5();
   double near=atr>0 ? atr*0.20 : SymbolInfoDouble(gSym,SYMBOL_POINT)*InpMinSL_Points*0.10;
   bool strong=(sig.str=="MANH");

   if(sig.sig=="BUY" && !InpOnlySell)
   {
      p.dir="BUY";
      p.clr=C_GREEN;
      p.entry=(strong || MathAbs(bid-e.f)<=near) ? ask : e.f;
      p.note=strong ? "Break/cross confirmed" : "Cho gia hoi ve EMA fast";
      p.ready=BuildAutoEntryStops(POSITION_TYPE_BUY,p.entry,p.sl,p.tp);
   }
   else if(sig.sig=="SELL" && !InpOnlyBuy)
   {
      p.dir="SELL";
      p.clr=C_RED;
      p.entry=(strong || MathAbs(bid-e.f)<=near) ? bid : e.f;
      p.note=strong ? "Break/cross confirmed" : "Cho gia hoi ve EMA fast";
      p.ready=BuildAutoEntryStops(POSITION_TYPE_SELL,p.entry,p.sl,p.tp);
   }
   return p;
}

bool BuildAutoEntryStopsFromAnalysis(const int dir,const double marketEntry,double& sl,double& tp,string& detail)
{
   EntryPlan p;
   detail="";
   bool hasPlan=false;

   if(gManualPlanActive && gManualPlan.ready)
   {
      p=gManualPlan;
      hasPlan=true;
      detail="manual ANALYZE plan";
   }
   else
   {
      hasPlan=AnalyzeCandlesOnDemand(p,detail);
      if(hasPlan) detail="auto 3D analysis: "+detail;
   }

   if(!hasPlan || !p.ready)
   {
      detail=(detail=="" ? "analysis plan unavailable" : detail);
      return false;
   }

   bool dirMatch=(dir==POSITION_TYPE_BUY && p.dir=="BUY") || (dir==POSITION_TYPE_SELL && p.dir=="SELL");
   if(!dirMatch)
   {
      detail=StringFormat("analysis direction %s does not match EMA cross",p.dir);
      return false;
   }

   sl=p.sl;
   tp=p.tp;
   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   double minDist=(double)SymbolInfoInteger(gSym,SYMBOL_TRADE_STOPS_LEVEL)*pt;
   if(minDist<=0) minDist=InpMinSL_Points*pt*0.10;
   if(minDist<=0) minDist=pt;
   bool invalid=(dir==POSITION_TYPE_BUY)
      ? ((marketEntry-sl)<minDist || (tp>0 && (tp-marketEntry)<minDist))
      : ((sl-marketEntry)<minDist || (tp>0 && (marketEntry-tp)<minDist));
   if(invalid)
   {
      detail=StringFormat("%s | ANALYZE SL/TP too close for market entry %.2f",detail,marketEntry);
      return false;
   }
   detail=StringFormat("%s | SL from ANALYZE %.2f | TP %.2f",detail,sl,tp);
   return (sl>0 && tp>0);
}

bool AnalyzeAndPlaceLimit(string& detail)
{
   EntryPlan p;
   detail="";
   if(!AnalyzeCandlesOnDemand(p,detail) || !p.ready)
   {
      statLimitFail++;
      gManualPlanActive=false;
      gManualPlanTime=TimeCurrent();
      gManualPlanText=(detail=="" ? "Limit: no clean setup" : detail);
      return false;
   }

   gManualPlan=p;
   gManualPlanActive=true;
   gManualPlanTime=TimeCurrent();
   gManualPlanText=detail;

   double ask=SymbolInfoDouble(gSym,SYMBOL_ASK);
   double bid=SymbolInfoDouble(gSym,SYMBOL_BID);
   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   double minDist=(double)SymbolInfoInteger(gSym,SYMBOL_TRADE_STOPS_LEVEL)*pt;
   if(minDist<=0) minDist=InpMinSL_Points*pt*0.10;
   if(minDist<=0) minDist=pt;

   datetime exp=0;
   ENUM_ORDER_TYPE_TIME timeType=ORDER_TIME_GTC;
   if(InpLimitExpireHours>0)
   {
      timeType=ORDER_TIME_SPECIFIED;
      exp=TimeCurrent()+InpLimitExpireHours*3600;
   }

   bool ok=false;
   if(p.dir=="BUY")
   {
      if(p.entry >= ask-minDist)
      {
         statLimitFail++;
         detail=StringFormat("BUY LIMIT skipped: entry %.2f is not below Ask %.2f enough",p.entry,ask);
         return false;
      }
      ok=trade.BuyLimit(InpLotSize,p.entry,gSym,p.sl,p.tp,timeType,exp,
                        StringFormat("ANALYZE BuyLimit %dD",gAnalysisDays));
   }
   else if(p.dir=="SELL")
   {
      if(p.entry <= bid+minDist)
      {
         statLimitFail++;
         detail=StringFormat("SELL LIMIT skipped: entry %.2f is not above Bid %.2f enough",p.entry,bid);
         return false;
      }
      ok=trade.SellLimit(InpLotSize,p.entry,gSym,p.sl,p.tp,timeType,exp,
                         StringFormat("ANALYZE SellLimit %dD",gAnalysisDays));
   }
   else
   {
      statLimitFail++;
      detail="LIMIT skipped: analysis has no BUY/SELL direction";
      return false;
   }

   if(ok)
   {
      statLimitOk++;
      detail=StringFormat("%s LIMIT placed | Entry %.2f | SL %.2f | TP %.2f | Exp %dh",
                          p.dir,p.entry,p.sl,p.tp,InpLimitExpireHours);
      TG_Send(detail);
      return true;
   }

   statLimitFail++;
   detail=StringFormat("%s LIMIT failed: %s (%d)",p.dir,trade.ResultComment(),trade.ResultRetcode());
   TG_OnFail(p.dir+" LIMIT",trade.ResultComment());
   return false;
}

bool AnalyzeCandlesOnDemand(EntryPlan& plan,string& detail)
{
   plan.ready=false; plan.dir="WAIT"; plan.note="No setup"; plan.entry=0; plan.sl=0; plan.tp=0; plan.clr=C_ORANGE;
   detail="No 3-day candle setup";

   int tfSec=PeriodSeconds(PERIOD_M5);
   int barsPerDay=(tfSec>0 ? 86400/tfSec : 288);
   int lookback=MathMax(60,gAnalysisDays*barsPerDay);
   MqlRates r[];
   ArraySetAsSeries(r,true);
   int got=CopyRates(gSym,PERIOD_M5,0,lookback+5,r);
   int n=MathMin(lookback,got-1);
   if(n<120)
   {
      detail=StringFormat("Need more M5 history for %d-day analysis",gAnalysisDays);
      return false;
   }

   EmaSnap ema;
   if(!GetEMA(ema))
   {
      detail="EMA unavailable";
      return false;
   }
   Signal sig=Analyze(ema);

   double pt=SymbolInfoDouble(gSym,SYMBOL_POINT);
   double ask=SymbolInfoDouble(gSym,SYMBOL_ASK);
   double bid=SymbolInfoDouble(gSym,SYMBOL_BID);
   double atr=ATR_M5();
   double minPad=(atr>0 ? atr*0.15 : InpMinSL_Points*pt*0.10);

   double hi=r[1].high,lo=r[1].low;
   int recentN=MathMin(96,n);
   double recentHi=r[1].high,recentLo=r[1].low;
   int bull=0,bear=0;
   double bodySum=0,rangeSum=0;
   long volSum=0;
   for(int i=1;i<=n;i++)
   {
      hi=MathMax(hi,r[i].high);
      lo=MathMin(lo,r[i].low);
      if(i<=recentN)
      {
         recentHi=MathMax(recentHi,r[i].high);
         recentLo=MathMin(recentLo,r[i].low);
      }
      if(r[i].close>r[i].open) bull++;
      else if(r[i].close<r[i].open) bear++;
      bodySum+=MathAbs(r[i].close-r[i].open);
      rangeSum+=MathMax(r[i].high-r[i].low,pt);
      volSum+=(long)r[i].tick_volume;
   }

   double closeNow=r[1].close;
   double closeStart=r[n].close;
   double threeRange=MathMax(hi-lo,pt);
   double recentRange=MathMax(recentHi-recentLo,pt);
   double pos3d=(closeNow-lo)/threeRange;
   double pressure=(double)(bull-bear)/(double)n;

   int bestDir=-1,bestScore=0,bestIdx=1;
   string pattern="3-day value pullback";
   int scanN=MathMin(36,n-1);
   for(int i=1;i<=scanN;i++)
   {
      double o1=r[i].open,c1=r[i].close,h1=r[i].high,l1=r[i].low;
      double o2=r[i+1].open,c2=r[i+1].close;
      double range=MathMax(h1-l1,pt);
      double body=MathAbs(c1-o1);
      double upper=h1-MathMax(o1,c1);
      double lower=MathMin(o1,c1)-l1;
      bool bullCandle=(c1>o1);
      bool bearCandle=(c1<o1);
      bool bullEngulf=bullCandle && c2<o2 && c1>o2 && o1<c2;
      bool bearEngulf=bearCandle && c2>o2 && c1<o2 && o1>c2;
      bool bullPin=lower>=body*1.8 && upper<=range*0.35 && c1>l1+range*0.55;
      bool bearPin=upper>=body*1.8 && lower<=range*0.35 && c1<l1+range*0.45;
      bool bullMomentum=bullCandle && body>=range*0.60 && c1>ema.f;
      bool bearMomentum=bearCandle && body>=range*0.60 && c1<ema.f;
      int recency=scanN-i+1;
      int sc=0,dir0=-1;
      string pat="";
      if(bullEngulf){ sc=45+recency; dir0=POSITION_TYPE_BUY; pat="Bullish engulfing"; }
      else if(bearEngulf){ sc=45+recency; dir0=POSITION_TYPE_SELL; pat="Bearish engulfing"; }
      else if(bullPin){ sc=38+recency; dir0=POSITION_TYPE_BUY; pat="Bullish rejection wick"; }
      else if(bearPin){ sc=38+recency; dir0=POSITION_TYPE_SELL; pat="Bearish rejection wick"; }
      else if(bullMomentum){ sc=30+recency; dir0=POSITION_TYPE_BUY; pat="Bullish momentum"; }
      else if(bearMomentum){ sc=30+recency; dir0=POSITION_TYPE_SELL; pat="Bearish momentum"; }
      if(sc>bestScore)
      {
         bestScore=sc;
         bestDir=dir0;
         bestIdx=i;
         pattern=pat;
      }
   }

   int bias=0;
   if(closeNow>closeStart) bias+=1; else bias-=1;
   if(pos3d>0.62) bias+=1; else if(pos3d<0.38) bias-=1;
   if(pressure>0.06) bias+=1; else if(pressure<-0.06) bias-=1;
   if(ema.f>ema.m && ema.m>ema.s) bias+=2;
   else if(ema.f<ema.m && ema.m<ema.s) bias-=2;
   if(sig.sig=="BUY") bias+=1;
   else if(sig.sig=="SELL") bias-=1;
   if(bestDir==POSITION_TYPE_BUY) bias+=2;
   else if(bestDir==POSITION_TYPE_SELL) bias-=2;

   int dir=-1;
   if(bias>=2 && !InpOnlySell) dir=POSITION_TYPE_BUY;
   else if(bias<=-2 && !InpOnlyBuy) dir=POSITION_TYPE_SELL;

   if(dir<0)
   {
      detail=StringFormat("%dD M5 neutral | Bias %d | Range %.2f..%.2f",gAnalysisDays,bias,lo,hi);
      return false;
   }

   double mid=(r[bestIdx].open+r[bestIdx].close)*0.5;
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   plan.dir=(dir==POSITION_TYPE_BUY)?"BUY":"SELL";
   plan.clr=(dir==POSITION_TYPE_BUY)?C_GREEN:C_RED;

   if(dir==POSITION_TYPE_BUY)
   {
      double valueZone=recentLo+recentRange*0.382;
      double pullback=MathMax(recentLo+minPad,MathMin(MathMax(valueZone,mid),ema.f));
      if(pullback<=0 || pullback>ask+recentRange) pullback=MathMin(ema.f,closeNow);
      bool nearNow=(ask<=pullback+minPad && ask>=pullback-minPad);
      plan.entry=NormalizeDouble(nearNow?ask:pullback,dg);
      plan.note=nearNow?"3D value zone now":"Wait pullback to 3D value";
   }
   else
   {
      double valueZone=recentHi-recentRange*0.382;
      double pullback=MathMin(recentHi-minPad,MathMax(MathMin(valueZone,mid),ema.f));
      if(pullback<=0 || pullback<bid-recentRange) pullback=MathMax(ema.f,closeNow);
      bool nearNow=(bid>=pullback-minPad && bid<=pullback+minPad);
      plan.entry=NormalizeDouble(nearNow?bid:pullback,dg);
      plan.note=nearNow?"3D value zone now":"Wait pullback to 3D value";
   }

   plan.ready=BuildAutoEntryStops(dir,plan.entry,plan.sl,plan.tp);
   if(!plan.ready)
   {
      detail="Candle setup found but SL/TP failed";
      return false;
   }

   double riskPts=pt>0?MathAbs(plan.entry-plan.sl)/pt:0;
   detail=StringFormat("%dD M5 %s %s | Bias %d | Entry %.2f | Risk %.0fpt",
                       gAnalysisDays,pattern,plan.dir,bias,plan.entry,riskPts);
   return true;
}

