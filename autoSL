void DrawEmaCanvas()
{
   if(!gCanvasReady) return;
   int W = CanvasW();
   int H = CanvasH();
   int bars = MathMax(40, sz(75));
   double ef[], em[], es[];
   ArraySetAsSeries(ef,true); ArraySetAsSeries(em,true); ArraySetAsSeries(es,true);
   if(CopyBuffer(hFast,0,0,bars,ef)<bars) return;
   if(CopyBuffer(hMid, 0,0,bars,em)<bars) return;
   if(CopyBuffer(hSlow,0,0,bars,es)<bars) return;
   double mn=DBL_MAX, mx=-DBL_MAX;
   for(int i=0;i<bars;i++){
      mn=MathMin(mn,MathMin(ef[i],MathMin(em[i],es[i])));
      mx=MathMax(mx,MathMax(ef[i],MathMax(em[i],es[i])));
   }
   double range=mx-mn;
   if(range<=0) return;
   double pad=range*0.10;
   mn-=pad; mx+=pad; range=mx-mn;
   const int PL=4,PR=4,PT=5,PB=5;
   int cW=W-PL-PR, cH=H-PT-PB;
   int plotW=(int)(cW*0.66);
   int plotX0=PL;
   int plotX1=plotX0+plotW;
   double barW=(bars>1)?(double)plotW/(bars-1):0.0;
   if(gEmaCanvas.Width()!=W||gEmaCanvas.Height()!=H) gEmaCanvas.Resize(W,H);
   gEmaCanvas.Erase(ColorToARGB(C'5,9,17',255));
   uint gridC=ColorToARGB(C'22,30,50',255);
   for(int g=1;g<=3;g++){
      int gy=PT+g*cH/4;
      for(int x=plotX0;x<=plotX1;x+=5) gEmaCanvas.PixelSet(x,gy,gridC);
   }
   for(int vb=10;vb<bars;vb+=10){
      int gx=plotX0+(int)((bars-1-vb)*barW);
      for(int y=PT;y<H-PB;y+=5) gEmaCanvas.PixelSet(gx,y,gridC);
   }
   uint cF=ColorToARGB(C_YELLOW,230),cM=ColorToARGB(C_CYAN,220),cS=ColorToARGB(C_ORANGE,200);
   for(int i=bars-2;i>=0;i--){
      int bi0=bars-2-i,bi1=bars-1-i;
      int xa=plotX0+(int)(bi0*barW),xb=plotX0+(int)(bi1*barW);
      int yS0=MathMax(PT,MathMin(H-PB,PT+(int)((mx-es[i+1])/range*cH)));
      int yS1=MathMax(PT,MathMin(H-PB,PT+(int)((mx-es[i])  /range*cH)));
      int yM0=MathMax(PT,MathMin(H-PB,PT+(int)((mx-em[i+1])/range*cH)));
      int yM1=MathMax(PT,MathMin(H-PB,PT+(int)((mx-em[i])  /range*cH)));
      int yF0=MathMax(PT,MathMin(H-PB,PT+(int)((mx-ef[i+1])/range*cH)));
      int yF1=MathMax(PT,MathMin(H-PB,PT+(int)((mx-ef[i])  /range*cH)));
      gEmaCanvas.Line(xa,yS0,xb,yS1,cS);
      gEmaCanvas.Line(xa,yM0,xb,yM1,cM);
      gEmaCanvas.Line(xa,yF0,xb,yF1,cF);
   }
   int crossLabelCount=0;
   int maxCrossLabels=4;
   int recentBarsForLabel=24;
   int labelFont=MathMax(10,MathMin(15,fs(9)));
   for(int i=bars-2;i>=1;i--){
      bool wasBelowMid=(ef[i+1]<=em[i+1]),nowAboveMid=(ef[i]>em[i]);
      bool wasAboveMid=(ef[i+1]>=em[i+1]),nowBelowMid=(ef[i]<em[i]);
      bool goldenCross=wasBelowMid&&nowAboveMid,deathCross=wasAboveMid&&nowBelowMid;
      if(!goldenCross&&!deathCross) continue;
      int bi=bars-1-i;
      int xDot=plotX0+(int)(bi*barW);
      double midPrice=(ef[i]+em[i])*0.5;
      int yDot=MathMax(PT+6,MathMin(H-PB-6,PT+(int)((mx-midPrice)/range*cH)));
      uint dotC=goldenCross?ColorToARGB(C_GREEN,245):ColorToARGB(C_RED,245);
      gEmaCanvas.FillCircle(xDot,yDot,5,dotC);
      gEmaCanvas.Circle(xDot,yDot,5,ColorToARGB(C'210,218,238',200));
      bool showLabel=(i<=recentBarsForLabel && crossLabelCount<maxCrossLabels);
      if(!showLabel) continue;
      crossLabelCount++;
      string priceStr=DoubleToString(midPrice,2);
      uint lblC=goldenCross?ColorToARGB(C_GREEN,255):ColorToARGB(C_RED,255);
      int lblH=labelFont+6;
      int yLbl=goldenCross?yDot-5-3-lblH:yDot+5+3;
      yLbl=MathMax(PT,MathMin(H-PB-lblH,yLbl));
      int lblW=(int)(StringLen(priceStr)*(labelFont*0.66));
      int xLbl=MathMax(plotX0,MathMin(plotX1-lblW,xDot-lblW/2));
      gEmaCanvas.FillRectangle(xLbl-4,yLbl-2,xLbl+lblW+4,yLbl+lblH+2,ColorToARGB(C'5,9,17',235));
      gEmaCanvas.Rectangle(xLbl-4,yLbl-2,xLbl+lblW+4,yLbl+lblH+2,ColorToARGB(C'210,218,238',120));
      gEmaCanvas.FontSet("Arial Bold",labelFont);
      gEmaCanvas.TextOut(xLbl,yLbl+1,priceStr,lblC);
   }
   double cp=SymbolInfoDouble(gSym,SYMBOL_BID);
   int yP=MathMax(PT,MathMin(H-PB,PT+(int)((mx-cp)/range*cH)));
   for(int x=plotX0;x<=plotX1;x+=6){
      gEmaCanvas.PixelSet(x,  yP,ColorToARGB(C'160,168,195',160));
      gEmaCanvas.PixelSet(x+1,yP,ColorToARGB(C'160,168,195',160));
   }
   gEmaCanvas.FillCircle(W-52,PT+5,3,ColorToARGB(C_YELLOW,230));
   gEmaCanvas.FillCircle(W-36,PT+5,3,ColorToARGB(C_CYAN,  220));
   gEmaCanvas.FillCircle(W-20,PT+5,3,ColorToARGB(C_ORANGE,210));
   gEmaCanvas.Update();
}

void DeleteObjectsByPrefix(const string prefix)
{
   for(int i=ObjectsTotal(0,0,-1)-1;i>=0;i--)
   {
      string n=ObjectName(0,i,0,-1);
      if(StringFind(n,prefix)==0) ObjectDelete(0,n);
   }
}

void UpsertTrend(const string n,datetime t1,double p1,datetime t2,double p2,color clr,int width)
{
   if(ObjectFind(0,n)<0)
      ObjectCreate(0,n,OBJ_TREND,0,t1,p1,t2,p2);
   else
   {
      ObjectMove(0,n,0,t1,p1);
      ObjectMove(0,n,1,t2,p2);
   }
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_WIDTH,width);
   ObjectSetInteger(0,n,OBJPROP_STYLE,STYLE_SOLID);
   ObjectSetInteger(0,n,OBJPROP_RAY_RIGHT,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
}

void UpsertHLine(const string n,double price,color clr,int width,int style)
{
   if(ObjectFind(0,n)<0)
      ObjectCreate(0,n,OBJ_HLINE,0,0,price);
   else
      ObjectSetDouble(0,n,OBJPROP_PRICE,price);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_WIDTH,width);
   ObjectSetInteger(0,n,OBJPROP_STYLE,style);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
}

void UpsertText(const string n,datetime t,double price,string txt,color clr,int fsize)
{
   if(ObjectFind(0,n)<0)
      ObjectCreate(0,n,OBJ_TEXT,0,t,price);
   else
      ObjectMove(0,n,0,t,price);
   ObjectSetString(0,n,OBJPROP_TEXT,txt);
   ObjectSetString(0,n,OBJPROP_FONT,"Arial Bold");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,fsize);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
}

void UpsertArrow(const string n,datetime t,double price,color clr,int width,int code)
{
   if(ObjectFind(0,n)<0)
      ObjectCreate(0,n,OBJ_ARROW,0,t,price);
   else
      ObjectMove(0,n,0,t,price);
   ObjectSetInteger(0,n,OBJPROP_ARROWCODE,code);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_WIDTH,width);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
}

void UpsertPriceBox(const string n,datetime t1,double p1,datetime t2,double p2,color bg,color bd)
{
   double top=MathMax(p1,p2);
   double bot=MathMin(p1,p2);
   if(ObjectFind(0,n)<0)
      ObjectCreate(0,n,OBJ_RECTANGLE,0,t1,top,t2,bot);
   else
   {
      ObjectMove(0,n,0,t1,top);
      ObjectMove(0,n,1,t2,bot);
   }
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_COLOR,bd);
   ObjectSetInteger(0,n,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,n,OBJPROP_STYLE,STYLE_SOLID);
   ObjectSetInteger(0,n,OBJPROP_FILL,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
}

void DrawChartOverlay()
{
   int bars=MathMin(120,Bars(gSym,PERIOD_M5));
   if(bars<3) return;
   double ef[],em[],es[];
   datetime tm[];
   ArraySetAsSeries(ef,true); ArraySetAsSeries(em,true); ArraySetAsSeries(es,true); ArraySetAsSeries(tm,true);
   if(CopyBuffer(hFast,0,0,bars,ef)<bars) return;
   if(CopyBuffer(hMid, 0,0,bars,em)<bars) return;
   if(CopyBuffer(hSlow,0,0,bars,es)<bars) return;
   if(CopyTime(gSym,PERIOD_M5,0,bars,tm)<bars) return;

   for(int i=bars-2;i>=0;i--)
   {
      datetime t1=tm[i+1], t2=tm[i];
      UpsertTrend(OVERLAY_PREFIX+"ema_f_"+(string)i,t1,ef[i+1],t2,ef[i],C_YELLOW,2);
      UpsertTrend(OVERLAY_PREFIX+"ema_m_"+(string)i,t1,em[i+1],t2,em[i],C_CYAN,2);
      UpsertTrend(OVERLAY_PREFIX+"ema_s_"+(string)i,t1,es[i+1],t2,es[i],C_ORANGE,1);
   }

   datetime labelTime=tm[0]+PeriodSeconds(PERIOD_M5)*3;
   int dg=(int)SymbolInfoInteger(gSym,SYMBOL_DIGITS);
   UpsertText(OVERLAY_PREFIX+"lbl_f",labelTime,ef[0],"EMA "+(string)gEmaFast+" "+DoubleToString(ef[0],dg),C_YELLOW,8);
   UpsertText(OVERLAY_PREFIX+"lbl_m",labelTime,em[0],"EMA "+(string)gEmaMid+" "+DoubleToString(em[0],dg),C_CYAN,8);
   UpsertText(OVERLAY_PREFIX+"lbl_s",labelTime,es[0],"EMA "+(string)gEmaSlow+" "+DoubleToString(es[0],dg),C_ORANGE,8);

   int crossCount=0;
   for(int i=1;i<MathMin(bars-1,80) && crossCount<6;i++)
   {
      bool golden=(ef[i]>em[i] && ef[i+1]<=em[i+1]);
      bool death =(ef[i]<em[i] && ef[i+1]>=em[i+1]);
      if(!golden && !death) continue;
      double p=(ef[i]+em[i])*0.5;
      color cc=golden?C_GREEN:C_RED;
      string dir=golden?"BUY":"SELL";
      string id=OVERLAY_PREFIX+"cross_"+IntegerToString((long)tm[i]);
      UpsertArrow(id+"_dot",tm[i],p,cc,2,159);
      UpsertText(id+"_txt",tm[i]+PeriodSeconds(PERIOD_M5),p,dir+" "+DoubleToString(p,dg),cc,8);
      crossCount++;
   }

   EmaSnap ema;
   if(!GetEMA(ema)) return;
   EntryPlan plan=gManualPlan;
   if(!gManualPlanActive)
   {
      DeleteObjectsByPrefix(OVERLAY_PREFIX+"plan_");
      return;
   }
   if(plan.ready)
   {
      string prefix=OVERLAY_PREFIX+"plan_";
      UpsertHLine(prefix+"entry",plan.entry,plan.clr,2,STYLE_DASH);
      if(plan.sl>0) UpsertHLine(prefix+"sl",plan.sl,C_RED,1,STYLE_DOT);
      if(plan.tp>0) UpsertHLine(prefix+"tp",plan.tp,C_GREEN,1,STYLE_DOT);
      datetime pointTime=(gManualPlanActive && gManualPlanTime>0) ? gManualPlanTime : tm[0];
      UpsertArrow(prefix+"entry_dot",pointTime,plan.entry,plan.clr,3,159);
      if(plan.sl>0) UpsertArrow(prefix+"sl_dot",pointTime,plan.sl,C_RED,2,159);
      if(plan.tp>0) UpsertArrow(prefix+"tp_dot",pointTime,plan.tp,C_GREEN,2,159);
      string txt=StringFormat("%s entry %.2f | SL %.2f | TP %.2f",plan.dir,plan.entry,plan.sl,plan.tp);
      UpsertText(prefix+"label",labelTime,plan.entry,txt,plan.clr,9);
      if(gManualPlanActive)
      {
         bool isBuy=(plan.dir=="BUY");
         int arrowCode=isBuy?233:234;
         UpsertArrow(prefix+"ideal_arrow",pointTime,plan.entry,plan.clr,4,arrowCode);
         double atr=ATR_M5();
         double risk=MathMax(MathAbs(plan.entry-plan.sl),MathAbs(plan.tp-plan.entry));
         risk=MathMax(risk,atr>0?atr:SymbolInfoDouble(gSym,SYMBOL_POINT)*InpMinSL_Points);
         double boxH=risk*0.34;
         double center=isBuy ? plan.entry+boxH*1.35 : plan.entry-boxH*1.35;
         datetime boxT1=pointTime+PeriodSeconds(PERIOD_M5);
         datetime boxT2=pointTime+PeriodSeconds(PERIOD_M5)*22;
         color boxBg=isBuy?C'8,38,23':C'45,14,14';
         UpsertPriceBox(prefix+"ideal_cloud",boxT1,center+boxH,boxT2,center-boxH,boxBg,plan.clr);
         datetime textT=boxT1+PeriodSeconds(PERIOD_M5);
         UpsertText(prefix+"ideal_t1",textT,center+boxH*0.48,"IDEAL "+plan.dir,plan.clr,10);
         UpsertText(prefix+"ideal_t2",textT,center+boxH*0.10,"ENTRY "+DoubleToString(plan.entry,dg),C_WHITE,8);
         UpsertText(prefix+"ideal_t3",textT,center-boxH*0.28,"SL "+DoubleToString(plan.sl,dg)+" | TP "+DoubleToString(plan.tp,dg),C_WHITE,8);
         UpsertText(prefix+"note",labelTime,plan.tp>0?plan.tp:plan.entry,gManualPlanText,plan.clr,8);
      }
      else
      {
         DeleteObjectsByPrefix(prefix+"ideal_");
      }
   }
   else
   {
      DeleteObjectsByPrefix(OVERLAY_PREFIX+"plan_");
   }
}

